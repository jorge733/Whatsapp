# Copia este archivo como ".env" (o ejecuta "npm run configurar") y completa tus datos.
# NUNCA subas el archivo .env a GitHub.

# Project URL de Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key de Supabase (sb_secret_... o la "service_role" antigua)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Opcionales
# AUTH_FOLDER=auth            # carpeta donde se guarda la sesión de WhatsApp
# BAILEYS_LOG_LEVEL=silent    # detalle técnico de WhatsApp: silent, error, warn, info, debug
